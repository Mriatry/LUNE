{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "编译并调试当前 C 文件",
            "type": "cppdbg",
            "request": "launch",
            "program": "D:\\CProjects\\bin\\${fileBasenameNoExtension}.exe",
            "args": [],
